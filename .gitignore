# --- Godot: кэш импорта -----------------------------------------------------
# Восстанавливается командой `--import`. Без него проект не запустится, но и
# хранить его незачем: это производные .ctex/.cache от art/ и content/.
# Здесь же валяются временные файлы uid_cache.bin~RF*.TMP от самого движка.
.godot/

# --- Рабочая папка планирования ---------------------------------------------
# Сюда навык subagent-driven-development складывает журнал прогона, брифы задач
# и пакеты для ревью. Это черновики одной сессии, а не часть проекта. Папка
# игнорируется, но её уничтожает `git clean -fdx` — восстановление по git log.
.superpowers/

# Экспортированные сборки (папки экспорта по умолчанию из шаблонов Godot).
build/
export/
*.pck

# --- Отчёты проверок --------------------------------------------------------
# ВСЕ диагностические отчёты генерируются режимами (`--validate`, `--loop`,
# `--sim`, `--art` и прочие) и перезаписываются при каждом прогоне.
#
# Почему их не версионируем. Это не «мусор» — это улики, и они остаются на диске.
# Но закоммиченный отчёт СТАРЕЕТ молча: числа в нём от того кода, при котором он
# был записан. В проекте, где всё держится на замерах, лежащий в репозитории
# устаревший отчёт выглядит как свидетельство, а свидетельствует о прошлом.
# Такие файлы уже дважды принимали за свежий результат.
#
# Список намеренно широкий: `_*` покрывает отчёты, трассы прогона и служебные
# файлы вроде _glog.txt и _orders.txt. Ничего нужного в репозитории с `_` в начале
# имени нет by design — этим префиксом помечено производное.
_*
!_*.bat

# Отчёт симулятора баланса. Отдельной строкой, потому что его имя НЕ начинается
# с подчёркивания: правило `_*` выше его не ловит, и он уже просочился в индекс.
# Пишется режимом `--sim` в res://sim_report.json (LogicChecks.sim).
sim_report.json

# Снимки экранов (режим --shots).
_shots/

# Бэкапы от редактора.
*.bak
*.orig

# --- Чужой код --------------------------------------------------------------
# MCP-сервер для Godot написан не нами (автор hybridindie, plugin.cfg) и
# обновляется отдельно. Держать в нашем репозитории чужую копию — значит хранить
# её версию как свою и получить конфликт при обновлении.
addons/godot_mcp/

# --- Мусор от инструментов --------------------------------------------------
# Временные каталоги Python (pip) и системные файлы Windows.
_tools/tmp/
Thumbs.db
desktop.ini
