[resource]
script = ExtResource("4_mon")
id = &"ashmother"
title = "Пепел-Мать"
epithet = "роевая носительница"
lore = "Она не охотится сама: рой делает это за неё и всегда возвращается. Пока рой движется, она стоит на месте и ждёт. Без роя — просто большое тело."
rank = &"elite"
max_hp = 22
armor = 2
base_damage = 3
initiative = 4
weakness_types = PackedStringArray("fire", "poison", "slash")
type_resist = {
"crush": 1,
"ice": 1
}
scenarios = Array[ExtResource("3_scn")]([SubResource("scn_burst"), SubResource("scn_bite"), SubResource("scn_eggs")])
false_leads = Array[ExtResource("2_sig")]([SubResource("decoy_burst_gaze"), SubResource("decoy_burst_sound"), SubResource("decoy_burst_pose"), SubResource("decoy_bite_gaze"), SubResource("decoy_bite_sound"), SubResource("decoy_bite_pose"), SubResource("decoy_eggs_gaze"), SubResource("decoy_eggs_env"), SubResource("decoy_eggs_pose")])
combos = Array[ExtResource("1_cmb")]([SubResource("cmb_burn_swarm"), SubResource("cmb_poison_sting")])
adaptations = Array[Dictionary]([{
"after_round": 5,
"multiplier": 1.1,
"scenario": &"burst"
}, {
"after_round": 9,
"multiplier": 1.15,
"scenario": &"bite"
}])
counter_threshold = 3
counter_title = "Плотный рой"
counter_text = "Рой стягивается коркой: огонь больше не пробивает его насквозь."
ticking_damage = 1
ticking_key_scenario = &"burst"
ticking_text = "Рой осыпается на землю. Больше он тебя не грызёт."
trophy_names = PackedStringArray("Роевой фермент", "Маточный панцирь")
trophy_prices = PackedInt32Array(30, 45)
portrait = ExtResource("5_art")
silhouette = ExtResource("5_art")
accent_color = "#6d5644"
art_scale = 1.0
art_offset = Vector2(0, 0)
