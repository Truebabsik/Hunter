[resource]
script = ExtResource("4_mon")
id = &"hruz"
title = "Хруз"
epithet = "береговой трущобник"
lore = "Держится у воды: там его не обойти и не увидеть заранее. Бьёт всем весом, а не скоростью, и потому первый удар почти всегда его. Уходя, всегда тащит добычу к норе — значит, гнездо рядом."
rank = &"starter"
max_hp = 12
armor = 2
base_damage = 3
initiative = 4
weakness_types = PackedStringArray("ice", "poison")
weakness_ranges = PackedStringArray("ranged")
range_resist = {}
type_resist = {
"fire": 1,
"slash": 1,
"pierce": 1
}
scenarios = Array[ExtResource("3_scn")]([SubResource("scn_pounce"), SubResource("scn_claw"), SubResource("scn_roar")])
false_leads = Array[ExtResource("2_sig")]([SubResource("decoy_pounce"), SubResource("decoy_claw"), SubResource("decoy_roar")])
combos = Array[ExtResource("1_cmb")]([SubResource("cmb_ice_pounce"), SubResource("cmb_poison_claw")])
counter_threshold = 3
counter_title = "Береговой манёвр"
counter_text = "Хруз меняет стойку: присед исчезает, клешня разжимается. Он смотрит на тебя иначе."
trophy_names = PackedStringArray("Панцирная пластина", "Ракушечный порошок")
trophy_prices = PackedInt32Array(10, 5)
portrait = ExtResource("5_art")
silhouette = ExtResource("6_sil")
accent_color = "#7a6849"
art_scale = 0.95
art_offset = Vector2(0, 10)
by_scenario = {}
