[resource]
script = ExtResource("4_mon")
id = &"skorb"
title = "Скорб"
epithet = "костяная башня"
lore = "Мёртв дольше, чем стоит гильдия, и не собирается ложиться. Каждая кость движется отдельно — то, что ты видишь, ещё не он. Убить его можно только заново разобрав по костям."
rank = &"elite"
max_hp = 25
armor = 3
base_damage = 4
initiative = 2
weakness_types = PackedStringArray("fire")
weakness_ranges = PackedStringArray("ranged")
type_resist = {
"slash": 1,
"pierce": 1,
"ice": 1,
"poison": 1
}
scenarios = Array[ExtResource("3_scn")]([SubResource("scn_volley"), SubResource("scn_grasp"), SubResource("scn_roar"), SubResource("scn_rebuild")])
false_leads = Array[ExtResource("2_sig")]([SubResource("decoy_volley_gaze"), SubResource("decoy_volley_sound"), SubResource("decoy_volley_pose"), SubResource("decoy_grasp_gaze"), SubResource("decoy_grasp_sound"), SubResource("decoy_grasp_pose"), SubResource("decoy_roar_gaze"), SubResource("decoy_roar_sound"), SubResource("decoy_roar_pose"), SubResource("decoy_rebuild_gaze"), SubResource("decoy_rebuild_sound"), SubResource("decoy_rebuild_pose")])
combos = Array[ExtResource("1_cmb")]([SubResource("cmb_break_cage"), SubResource("cmb_bone_rain")])
adaptations = Array[Dictionary]([{
"after_round": 5,
"multiplier": 1.1,
"scenario": &"rebuild"
}, {
"after_round": 9,
"multiplier": 1.15,
"scenario": &"volley"
}])
counter_threshold = 3
counter_title = "Костяной щит"
counter_text = "Скорб поднимает рёбра клеткой: огонь больше не прерывает пересборку."
trophy_names = PackedStringArray("Костяной залп", "Рёберная броня")
trophy_prices = PackedInt32Array(35, 40)
portrait = ExtResource("5_art")
silhouette = ExtResource("5_art")
accent_color = "#d8d2c4"
art_scale = 1.1
art_offset = Vector2(0, 0)
by_scenario = {}
