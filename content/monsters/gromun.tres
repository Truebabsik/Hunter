[resource]
script = ExtResource("4_mon")
id = &"gromun"
title = "Громун"
epithet = "гривастая гарпуна"
lore = "Костяные шипы на крыльях отрастают заново, поэтому трофей ценят, а зверя не добивают зря. Бьёт с воздуха, где до него не достать. Гильдия не выпускает на него без дальнего боя."
rank = &"advanced"
max_hp = 15
armor = 2
base_damage = 3
initiative = 5
weakness_types = PackedStringArray("crush")
weakness_ranges = PackedStringArray("melee")
type_resist = {
"ice": 1
}
range_resist = {
"ranged": 2
}
scenarios = Array[ExtResource("3_scn")]([SubResource("scn_pike"), SubResource("scn_sweep"), SubResource("scn_roar")])
false_leads = Array[ExtResource("2_sig")]([SubResource("decoy_0"), SubResource("decoy_1"), SubResource("decoy_2"), SubResource("decoy_3"), SubResource("decoy_4"), SubResource("decoy_5")])
combos = Array[ExtResource("1_cmb")]([SubResource("cmb_break_pike"), SubResource("cmb_fire_roar")])
counter_threshold = 3
counter_title = "Воздушный вираж"
counter_text = "Громун уходит в вираж: ближний бой больше не достаёт, пока он кружит."
trophy_names = PackedStringArray("Костяной гарпун", "Грива")
trophy_prices = PackedInt32Array(25, 12)
portrait = ExtResource("5_art")
silhouette = ExtResource("5_art")
accent_color = "#8d7a5f"
art_scale = 1.0
art_offset = Vector2(0, -10)
by_scenario = {}