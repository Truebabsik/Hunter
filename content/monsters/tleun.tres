[resource]
script = ExtResource("4_mon")
id = &"tleun"
title = "Тлеун"
epithet = "болотный ходячий панцирь"
lore = "Стоит по колено в трясине и почти не двигается — ждёт, пока ты подойдёшь сам. Светится в темноте, но по свету его не найти: он сам знает, где ты. Панцирь идёт на щиты, и это единственная причина, по которой на него ходят."
rank = &"advanced"
max_hp = 18
armor = 3
base_damage = 4
initiative = 3
weakness_types = PackedStringArray("poison", "ice", "pierce")
type_resist = {
"fire": 1,
"crush": 1,
"slash": 1
}
scenarios = Array[ExtResource("3_scn")]([SubResource("scn_flame"), SubResource("scn_jaws"), SubResource("scn_mist")])
false_leads = Array[ExtResource("2_sig")]([SubResource("decoy_0"), SubResource("decoy_1"), SubResource("decoy_2"), SubResource("decoy_3"), SubResource("decoy_4"), SubResource("decoy_5")])
combos = Array[ExtResource("1_cmb")]([SubResource("cmb_quench"), SubResource("cmb_poison_mist")])
counter_threshold = 3
counter_title = "Густой туман"
counter_text = "Тлеун заливает всё вокруг: туман больше не рассеивается."
fog_enabled = true
fog_key_scenario = &"mist"
fog_title = "ТУМАН ОБЗОРА"
fog_text = "Туман осел. Ты снова видишь, что можно предположить."
trophy_names = PackedStringArray("Фосфорная железа", "Панцирный щит")
trophy_prices = PackedInt32Array(20, 30)
portrait = ExtResource("5_art")
silhouette = ExtResource("5_art")
accent_color = "#6f7d56"
art_scale = 0.95
art_offset = Vector2(0, 10)
by_scenario = {}