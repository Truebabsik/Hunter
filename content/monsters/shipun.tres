[resource]
script = ExtResource("4_mon")
id = &"shipun"
title = "Шипун"
epithet = "скользун-кочка"
lore = "Быстрее любого охотника на ровном месте, но на подъёме сдаёт. Держит дистанцию и ждёт, пока ты подойдёшь сам. В книге гильдии помечен как «недоделанный»: бросок быстрый, а хватка слабая."
rank = &"starter"
max_hp = 10
armor = 1
base_damage = 2
initiative = 6
weakness_types = PackedStringArray("poison")
weakness_ranges = PackedStringArray("ranged")
range_resist = {}
type_resist = {
"ice": 1,
"slash": 1,
"pierce": 1
}
scenarios = Array[ExtResource("3_scn")]([SubResource("scn_sting"), SubResource("scn_coil"), SubResource("scn_dash")])
false_leads = Array[ExtResource("2_sig")]([SubResource("decoy_sting"), SubResource("decoy_coil"), SubResource("decoy_dash")])
combos = Array[ExtResource("1_cmb")]([SubResource("cmb_poison_dash"), SubResource("cmb_fire_coil")])
counter_threshold = 3
counter_title = "Ложный рывок"
counter_text = "Шипун больше не подставляется: бок прикрыт, рывок короткий и злой."
trophy_names = PackedStringArray("Чешуйчатый плащ", "Жало")
trophy_prices = PackedInt32Array(15, 8)
portrait = ExtResource("5_art")
silhouette = ExtResource("5_art")
accent_color = "#7d8a5e"
art_scale = 0.9
art_offset = Vector2(0, 20)
by_scenario = {}
