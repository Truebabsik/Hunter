[sub_resource type="Resource" id="scn_devour"]
script = ExtResource("3_scn")
id = &"devour"
card_label = "Схватит и сожрёт"
description = "Сгущает тьму вокруг пасти и втягивает охотника."
weight = 30
signals = Array[ExtResource("2_sig")]([SubResource("sig_devour_dark"), SubResource("sig_devour_light")])
damage_override = 7
tags = PackedStringArray("grab")

[sub_resource type="Resource" id="scn_cascade"]
script = ExtResource("3_scn")
id = &"cascade"
card_label = "Обрушит шипы"
description = "Дробит шипы каскадом сверху вниз."
weight = 25
signals = Array[ExtResource("2_sig")]([SubResource("sig_cascade_spikes"), SubResource("sig_cascade_ring")])
damage_override = 5
tags = PackedStringArray("aoe")

[sub_resource type="Resource" id="scn_silence"]
script = ExtResource("3_scn")
id = &"silence"
card_label = "Заревёт в тишину"
description = "Забирает звук из мира и бьёт этой пустотой. Блок не помогает."
weight = 20
signals = Array[ExtResource("2_sig")]([SubResource("sig_silence_room"), SubResource("sig_silence_pose")])
damage_override = 5
unblockable = true
tags = PackedStringArray("roar")

[sub_resource type="Resource" id="scn_call"]
script = ExtResource("3_scn")
id = &"call"
card_label = "Позовёт слуг"
description = "Отпускает тени по краю света и подзывает их."
weight = 15
signals = Array[ExtResource("2_sig")]([SubResource("sig_call_gear"), SubResource("sig_call_rustle")])
damage_override = 3
tags = PackedStringArray("summon")

[sub_resource type="Resource" id="scn_variable"]
script = ExtResource("3_scn")
id = &"variable"
card_label = "Станет переменным"
description = "Переворачивает сигналы: то, что ты видишь, значит обратное."
weight = 10
signals = Array[ExtResource("2_sig")]([SubResource("sig_variable_signals"), SubResource("sig_variable_reality")])
damage_override = 3
tags = PackedStringArray("phase")

