[resource]
script = ExtResource("4_mon")
id = &"lament"
title = "Ламент"
epithet = "коронованный пожиратель сигналов"
lore = "Единственный, кто охотится не на охотников, а на то, чем они думают. Он повторяет увиденное и потому кажется знакомым. Все, кто его описывал, противоречат друг другу — и это лучшее, что о нём известно."
rank = &"legendary"
max_hp = 40
armor = 3
base_damage = 5
initiative = 5
weakness_types = PackedStringArray()
weakness_ranges = PackedStringArray()
type_resist = {}
range_resist = {}
scenarios = Array[ExtResource("3_scn")]([SubResource("scn_devour"), SubResource("scn_cascade"), SubResource("scn_silence"), SubResource("scn_call"), SubResource("scn_variable")])
false_leads = Array[ExtResource("2_sig")]([SubResource("decoy_devour_gaze"), SubResource("decoy_devour_pose"), SubResource("decoy_devour_sound"), SubResource("decoy_cascade_gaze"), SubResource("decoy_cascade_pose"), SubResource("decoy_cascade_sound"), SubResource("decoy_silence_sound"), SubResource("decoy_silence_env"), SubResource("decoy_silence_pose"), SubResource("decoy_call_gaze"), SubResource("decoy_call_pose"), SubResource("decoy_call_env"), SubResource("decoy_variable_gaze"), SubResource("decoy_variable_pose"), SubResource("decoy_variable_sound")])
combos = Array[ExtResource("1_cmb")]([SubResource("cmb_wreath"), SubResource("cmb_tear_dark"), SubResource("cmb_silence_break")])
phases = Array[Dictionary]([{
"hp_below": 0.3,
"id": &"worn",
"note": "Он выдохся: тьма отошла, блок больше не держит.",
"resist_ranges": {},
"resist_types": {},
"title": "Истощение",
"weak_ranges": PackedStringArray("melee"),
"weak_types": PackedStringArray("crush", "poison")
}, {
"hp_below": 0.7,
"id": &"rage",
"note": "Он перестал считаться с собой.",
"noise": 2.0,
"resist_ranges": {},
"resist_types": {},
"title": "Бешенство",
"weak_ranges": PackedStringArray(),
"weak_types": PackedStringArray()
}, {
"hp_below": 1.0,
"id": &"calm",
"note": "Он ещё играет с тобой.",
"noise": 1.0,
"resist_ranges": {},
"resist_types": {},
"title": "Спокойствие",
"weak_ranges": PackedStringArray(),
"weak_types": PackedStringArray()
}])
adaptations = Array[Dictionary]([{
"after_round": 5,
"multiplier": 1.15,
"scenario": &"variable"
}, {
"after_round": 9,
"multiplier": 1.2,
"scenario": &"variable"
}])
counter_threshold = 3
counter_title = "Пожирание сигнала"
counter_text = "Ламент съедает твой приём: сигналы вокруг него выворачиваются наизнанку."
trophy_names = PackedStringArray("Венок легенды", "Осколок тьмы")
trophy_prices = PackedInt32Array(100, 80)
portrait = ExtResource("5_art")
silhouette = ExtResource("5_art")
accent_color = "#6f5ea8"
art_scale = 1.05
art_offset = Vector2(0, -5)
by_scenario = {}
