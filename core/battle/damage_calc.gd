extends RefCounted
class_name DamageCalc
## Единственное место, где считаются формулы урона. Реализация — по GDD 12.5 и 12.6
## в редакции от 2026-09-22 (правки внесены в документ, см. docs/gdd_pravki.md).

enum Reading { MISS, PARTIAL, COUNTER, PERFECT }


## Урон игрока (GDD 12.5):
##   оружие + модификатор + чтение + комбо − панцирь зверя
## где типовая часть («модификатор») собрана в type_multiplier:
##   безусловный «+1» за руну (стихии симметричны, D04) плюс причины, названные
##   MonsterData.modifier_reasons: каждая запись уязвимости даёт +1, каждая запись
##   резиста −1, и срабатывает запись только когда И тип удара, И дистанция попали
##   в её множества (D23, GDD 12.3.1).
##
## ЧИСЛО НАБИРАЕТСЯ ЗДЕСЬ, а не приходит готовым: к безусловному «+1» руны
## (`element_bonus`) прибавляется сумма слагаемых, и знак каждого берётся из ТЕКСТА
## причины — `if "+1" in r.type_reasons[i]` (см. конец функции). Единственный
## источник ПРАВИЛА — модель вида: она решает, какая запись срабатывает; а знак
## слагаемого извлекается из её же подписи.
##
## Разбор строки как источника числа — известное слабое место, и оно оставлено
## осознанно. Оно уже дало дефект: строка «фаза: <название>» не несёт ни «+1», ни
## «−1», поэтому молча считалась «−1» и меняла модификатор у фаз, которые ничего
## не делают. Теперь строка печатается, только если фаза ДЕЙСТВИТЕЛЬНО меняет
## уязвимости (`MonsterData.phase_changes_weakness`), то есть число перестало
## зависеть от строки без знака. Но сама зависимость числа от ТЕКСТА причины
## осталась: замена на пару «причины + сумма» — отдельное решение, записанное как
## отложенное, потому что оно меняет форму разбора, а не только его надёжность.
##
## СУММА ПРИЧИН ЖИВЁТ ОТДЕЛЬНО ОТ МНОЖИТЕЛЯ — и это не дублирование. Тот же цикл
## считает обе величины: `type_multiplier` начинается с `element_bonus` («+1»
## элемента руны, D04) и только потом прибавляет причины, а `type_reasons_sum`
## прибавляет ОДНИ причины. Расходятся они ровно там, где элемент гасит штраф: удар
## руной в стену даёт множитель 0 при сумме −1. Поэтому вердикт удара (D19) читает
## `type_reasons_sum`, а НЕ `type_multiplier`: по множителю проза сказала бы
## «нейтрально» там, где разбор называет резист. Оба поля заполняются здесь и
## больше нигде; второй читатель, взявший множитель, повторит уже измеренную ошибку.
##
## phase — активная фаза зверя (GDD 4.8). Фаза ЗАМЕНЯЕТ уязвимости, если она их
## действительно задаёт (пустой список записей — это «фаза ничего не меняет», см.
## MonsterData.phase_changes_weakness); резисты база держит все фазы одинаково
## (D21.E).
##
## `target_open` — на звере статус «открыт» (комбо Тлеуна «Гашение»): любой удар
## проходит на 1 глубже, независимо от типа. Это НЕ уязвимость: она не привязана
## к типу и складывается с ним.
static func player_damage(
	weapon: WeaponData,
	monster: MonsterData,
	reading: Reading,
	combo_hit: bool,
	combo_bonus: int,
	perfect_read_bonus: int,
	phase: Dictionary = {},
	crit_chance: float = 0.0,
	rng: RandomNumberGenerator = null,
	target_open: bool = false
) -> DamageResult:
	var r := DamageResult.new()
	r.weapon_damage = weapon.base_damage

	match reading:
		Reading.PERFECT:
			r.reading_bonus = 1 + perfect_read_bonus
		Reading.COUNTER:
			r.reading_bonus = 1
		_:
			r.reading_bonus = 0

	if combo_hit and reading == Reading.PERFECT:
		r.combo_bonus = combo_bonus

	# Крит (GDD 7.3): навык даёт шанс, множитель — +50% базового урона оружия.
	# Считается от оружия, а не от итога: иначе крит усиливал бы и чтение, и комбо,
	# и один удачный бросок решал бы бой.
	if crit_chance > 0.0 and rng != null and rng.randf() < crit_chance:
		r.crit = true
		r.crit_bonus = maxi(1, int(round(float(weapon.base_damage) * 0.5)))

	# --- типовой множитель: уязвимости и резисты вида по ОБЕИМ координатам удара
	# (базовый тип оружия и элемент руны) и с учётом дистанции. Вся арифметика и
	# тексты причин — в MonsterData.modifier_reasons: один источник на правило
	# (D23, GDD 12.3.1).
	r.type_multiplier = 0

	# ВЕСЬ список типов удара берётся у оружия, а не собирается здесь заново. Раньше
	# эти три строки были ВТОРОЙ КОПИЕЙ правила «руна добавляет второй тип»: сегодня
	# она совпадала с источником, завтра разошлась бы молча — и урон считался бы по
	# одному списку, а показ и комбо по другому, как уже было с подписью копья.
	# Источник один: `WeaponData.damage_types`.
	var hit_types: Array = weapon.damage_types()

	# «+1 элемента руны» остаётся ОТДЕЛЬНЫМ слагаемым и не входит в сумму причин.
	# Он безусловен (D04: стихии симметричны, +1 даёт любая руна) и лишь потом
	# сам проверяется на уязвимость и резист — вторым проходом ниже.
	#
	# Цикл оставлен НАМЕРЕННО, хотя по сегодняшним данным это `hit_types.size() - 1`:
	# разницу задаёт источник (`damage_types_with` добавляет руну, только если она
	# непустая и не равна базовой), и здесь она выводится из САМОГО списка, а не из
	# знания о том, как он устроен. Правило «что считается элементом руны» остаётся
	# в одном месте, и правка источника сюда не дотянется молча.
	var element_bonus := 0
	for hit_type in hit_types:
		if hit_type != weapon.damage_type:
			element_bonus += 1

	if MonsterData.phase_changes_weakness(phase):
		r.type_reasons.append("фаза: %s" % str(phase.get("title", "")))

	var phase_reason_count := r.type_reasons.size()
	r.type_reasons.append_array(
		monster.modifier_reasons(hit_types, weapon.range_id, phase))

	# Число обязано сходиться с суммой слагаемых: если разбор называет причины,
	# их сумма плюс элемент руны и есть множитель. Это защита от расхождения
	# текста и числа — и от потери «+1 руны» при будущих правках.
	#
	# Вторая сумма — ТОЛЬКО причины, без «+1» руны: это источник вердикта удара
	# (D19, `DamageResult.type_reasons_sum`). Считается ЗДЕСЬ ЖЕ намеренно:
	# правило подписи причины («+1» — плюс, иначе минус) обязано остаться в одном
	# месте, а его вторая копия разошлась бы с этой молча (AGENTS §4).
	var summed := element_bonus
	var reasons_sum := 0
	for i in range(phase_reason_count, r.type_reasons.size()):
		if "+1" in r.type_reasons[i]:
			summed += 1
			reasons_sum += 1
		else:
			summed -= 1
			reasons_sum -= 1
	r.type_reasons_sum = reasons_sum
	r.type_multiplier = summed

	r.monster_armor = monster.armor

	# «Открыт»: зверь пропустил защиту, любой удар идёт глубже на 1. В разбор
	# попадает отдельным слагаемым (DamageResult.open_bonus) — второй записи в
	# type_reasons быть не должно, иначе строка называет одно и то же дважды.
	if target_open:
		r.open_bonus = 1

	var raw := (
		r.weapon_damage
		+ r.reading_bonus
		+ r.combo_bonus
		+ r.type_multiplier
		+ r.crit_bonus
		+ r.open_bonus
		- r.monster_armor
	)
	# Минимум 1: непроходимых из-за округления боёв нет (GDD 12.5, п. 53–57).
	r.min_clamped = raw < 1
	r.total = maxi(1, raw)
	return r


## Урон зверя (GDD 12.6): базовый урон или урон сценария − броня игрока.
## Панцирь зверя на его собственный урон не влияет.
##
## Минимум — 1, и он НЕ зависит от того, пробивается ли сценарий блоком (D01, D12,
## D13). Раньше здесь стоял maxi(0, …), то есть зверь мог нанести ноль: тяжёлая
## броня (поглощение 3) полностью гасила базовый урон Хруза (3). Это ломало
## воронку сложности — на старте зверь становился безобидным.
##
## Особый случай: сценарий может быть непробиваемым (GDD 4.4, «Вой-паралич не
## пробивается блоком»). Тогда броня не помогает вообще — но минимум 1 остаётся:
## правило одно на оба пути.
static func monster_damage(
	monster: MonsterData,
	scenario: ScenarioData,
	hunter: HunterState,
	softened: bool
) -> int:
	var base := monster.base_damage
	if scenario != null:
		base = scenario.damage_of(monster.base_damage)
	if softened:
		# «Частичное преимущество»: сценарий прочитан, инструмент — нет.
		# Зверь бьёт ослабленно (GDD 2.4).
		base = maxi(1, base - 1)
	if scenario != null and scenario.unblockable:
		return maxi(1, base)
	return maxi(1, base - hunter.total_absorption())


## Ожидаемый урон за раунд — только для симулятора и диагностики «стен чтения».
## Не участвует в боевых расчётах: бой всегда считает по факту.
static func expected_damage_per_round(weapon: WeaponData, monster: MonsterData) -> float:
	var d := player_damage(
		weapon,
		monster,
		Reading.COUNTER,
		false,
		0,
		0
	)
	return float(d.total)
