extends RefCounted
class_name HitReaction
## Вердикт удара игрока (D19): тип удара наткнулся на защиту зверя, нашёл щель
## или прошёл нейтрально.
##
## Вердикт — про ТИП, а не про силу удара. Источник — сумма причин «слабость +1 /
## резист −1» (поле `DamageResult.type_reasons_sum`), БЕЗ безусловного «+1» элемента
## руны (D04): в `type_multiplier` элемент уже прибавлен и в резист гасит штраф,
## поэтому удар руной в стену даёт там ноль — и по множителю проза сказала бы
## «нейтрально» там, где разбор называет резист (измерено на Ламанте).

const VERDICT_RESIST := &"resist"
const VERDICT_WEAK := &"weak"
const VERDICT_NEUTRAL := &"neutral"

## Слоты пула деталей реакции (D19). Идентификаторы живут ЗДЕСЬ, а не литералами
## у каждого читателя: сборка (Task 3) и проверка покрытия спрашивают одни и те же
## ведра, и вторая копия строки «reaction_verb» разошлась бы с первой молча
## (AGENTS.md §4). Значения обязаны совпадать с колонкой `slot` в
## `content/phrases/reactions.csv`.
const SLOT_CARRIER := &"reaction_carrier"
const SLOT_VERB := &"reaction_verb"
const SLOT_WEAPON := &"reaction_weapon"
const SLOT_ELEMENT := &"reaction_element"
const SLOT_INTRO := &"reaction_intro"

## Вердикт по знаку СУММЫ ПРИЧИН вида («слабость +1 / резист −1») без «+1» элемента
## руны (D04). Ноль — взаимодействия нет.
static func verdict_of(reasons_sum: int) -> StringName:
	if reasons_sum < 0:
		return VERDICT_RESIST
	if reasons_sum > 0:
		return VERDICT_WEAK
	return VERDICT_NEUTRAL


## Пунктуация принадлежит СБОРЩИКУ, а не данным: иначе знак пришлось бы дублировать
## в каждой строке CSV, и «двойная запятая» стала бы вопросом данных, а не правила.
## Пробел между носителем и глаголом — тот же случай: это разделитель шаблона, и
## сторож шва обязан спрашивать ЕГО, а не держать свою копию строки.
const P_AFTER_INTRO := ". "
const P_BEFORE_VERB := " "
const P_BEFORE_WEAPON := " — "
const P_BEFORE_ELEMENT := ", "
const P_END := "."


## Слоты пула деталей ОДНИМ списком: сторож формы обходит пул по нему, и второй
## такой список разошёлся бы с составом шаблона молча (AGENTS.md §4).
const DETAIL_SLOTS := [SLOT_CARRIER, SLOT_VERB, SLOT_WEAPON, SLOT_ELEMENT, SLOT_INTRO]


## Служебные слова, требующие зависимого слова (предлоги, союзы, союзные слова):
## деталь пула заканчиваться ими НЕ имеет права.
##
## Почему. Шаблон приставляет к КАЖДОЙ детали свой разделитель — `P_AFTER_INTRO`
## (точка после вводной), `P_BEFORE_VERB` (пробел после носителя),
## `P_BEFORE_WEAPON` (тире после глагола), `P_BEFORE_ELEMENT` (запятая после
## отпечатка, когда руна добавила тип) и `P_END` (точка после стихии и после
## отпечатка без руны). Незакрытый предлог перед разделителем обрывает фразу.
##
## Это ИСПРАВЛЕННЫЙ ДЕФЕКТ, и в пуле его БОЛЬШЕ НЕТ. Глагол был `равнодушен к`, и
## строка читалась «наковальня равнодушен к — опёрённый жгут» (измерено на
## `rx.verb.resist.04`); теперь там `держит удар`, и `равнодушен к` в
## `content/phrases/*.csv` не встречается ни разу (0 вхождений). Пример назван как
## история правила, а не как живая строка: искать `равнодушен к` в пуле нечего.
## Действующие примеры формы — `же` («Всё так же»), `так` («И снова так»), `мимо`
## («Снова мимо») ниже: они из живого пула.
##
## Список ОДИН на проект и живёт здесь, рядом с шаблоном: правило принадлежит
## шаблону, а спрашивает его сторож формы в `ContentValidator._check_reactions`.
## Копия в валидаторе разошлась бы с этой молча (AGENTS.md §4).
##
## ГРАНИЦЫ ПЕРЕЧНЯ НАЗВАНЫ ПРЯМО: это посев плюс однозначные служебные слова, а НЕ
## полный список предлогов и союзов русского языка. Полноты здесь нет и не
## обещается: пропущенное служебное слово — это латентная дыра сторожа (деталь на
## нём пройдёт зелёной), и закрывается она дописыванием слова сюда, а не верой в
## полноту. Список ЗАКРЫТЫЙ: расширять его безопасно только тем, чем ни одна
## деталь пула не кончается, — иначе сторож покрасит живой корректный контент.
##
## Чего в списке НЕТ и почему — измерено по пулу, а не выбрано на глаз. Последними
## словами деталей посева бывают `же` (пять вводных вида «Всё так же»), `так`
## («И снова так»), `мимо` («Снова мимо»), `точно` («И снова точно»), `краю`
## («иней по краю»): это частицы, наречия и существительные, которые фразу
## ЗАКРЫВАЮТ, а не обрывают. Поэтому в списке только служебные слова, требующие
## зависимого слова, а не «все короткие слова».
##
## Двусмысленные слова в список НЕ добавлены: `только`, `чуть`, `ли`, `ведь`,
## `всё`, `ещё` бывают частицами и наречиями и умеют фразу закрывать сами, а
## ложное срабатывание сторожа покрасило бы живой корректный контент.
##
## `едва` исключено НАМЕРЕННО, а не пропущено: в русском это ещё и союз
## («едва … как»), но в этом пуле `rx.intro.resist.01` = «Едва» фразу ЗАКРЫВАЕТ.
## Это объявленное исключение по союзному омониму, и оно названо здесь именно
## потому, что формально `едва` — служебное слово и в списке его ищут.
##
## Три добавленных слова — тоже с адвербиальными омонимами, и они оставлены в
## списке ОСОЗНАННО: `напротив` («дом напротив»), `внутри` («пусто внутри») и
## `спустя` («год спустя») способны закрывать фразу как наречие. Сейчас ни одна
## деталь пула ими не кончается (измерено обходом всего пула реакции), поэтому
## ложного срабатывания нет, а цена промаха несимметрична: пропущенный предлог —
## обрыв фразы в игре, пойманное наречие — красный сторож и правка одной детали.
const DETAIL_STOP_WORDS := [
	# предлоги
	"без", "в", "во", "ввиду", "вдоль", "вместо", "вокруг", "возле", "вроде",
	"вследствие", "благодаря", "для", "до", "за", "из", "из-за", "из-под",
	"к", "ко", "кроме", "между", "на", "над", "насчёт", "о", "об", "обо",
	"около", "от", "перед", "передо", "по", "под", "подо", "помимо", "поверх",
	"поперёк", "при", "про", "против", "ради", "с", "со", "сверх", "согласно",
	"среди", "сквозь", "у", "через", "навстречу",
	# предлоги, добавленные ревью задачи 4b: требуют зависимого слова
	"вопреки", "напротив", "наподобие", "вслед", "сродни", "наперекор",
	"внутри", "минуя", "спустя", "включая", "исключая",
	# союзы
	"а", "но", "да", "и", "или", "либо", "что", "чтобы", "как", "чем", "если",
	"хотя", "когда", "пока", "зато", "причём", "притом", "поскольку", "словно",
	"будто", "то", "ни",
	# союзы, добавленные ревью задачи 4b
	"нежели", "пусть", "коль",
]


## ВЕРХНЯЯ ГРАНИЦА перебора ступеней серии — и только она. Спрашивают её двое:
## `intro_role` (порог «жёсткой» ступени) и покрытие пула (докуда перебирать
## раунды). ИМЕНА ступеней она НЕ задаёт: имя выдаёт `intro_role`, поэтому подмена
## этой константы на 4 не переименует ничего и `--validate` НЕ покраснит — она лишь
## расширит перебор. Связку сторожит мутация, которая меняет и имя (`:= 4` плюс
## отдельная ветвь имени для `run == INTRO_MAX_RUN`): тогда валидатор называет три
## новые пустые группы вводных.
const INTRO_MAX_RUN := 3


## Группа вводной: ступень серии, но примерка перебивает ступень — смена оружия
## без удара не повтор удара.
static func intro_role(verdict: StringName, run: int, is_swap: bool) -> StringName:
	if is_swap:
		return &"swap"
	if run >= INTRO_MAX_RUN:
		return StringName("%s_hard" % verdict)
	if run == 2:
		return StringName("%s_again" % verdict)
	return verdict


## Сборка строки реакции из деталей пула (D19, §5 спеки).
##
## Шаблон `{вводная}. {носитель} {глагол} — {отпечаток}, {стихия}.` живёт ЗДЕСЬ, а
## детали — в данных. Пустая строка — это «сборки нет»: шаблон обязан быть собран
## целиком, обрубок соврал бы (правило «контент обещает — контент выполняет»),
## поэтому нехватка любой ОБЯЗАТЕЛЬНОЙ детали возвращает пусто, а не часть фразы.
##
## Первый аргумент `pick_phrase` — не везде id вида: `Database.phrases_for`
## откатывается ТОЛЬКО по сценарию, поэтому общие вёдра (у них пустой `monster`)
## достижимы лишь при `&""`. С id вида вернулся бы пустой массив, и дыра в пуле
## выглядела бы как «нет данных» вместо «нет фразы» — но обе ветки дают пустую
## строку, и молчать об этом сборщик не имеет права.
static func assemble(
	monster: MonsterData,
	weapon: WeaponData,
	verdict: StringName,
	run: int,
	is_swap: bool,
	rng: RandomNumberGenerator
) -> String:
	if monster == null or weapon == null:
		return ""
	# Голос `VOICE_REACTION` у ВСЕХ пяти деталей: у реакции своё окно антиповтора, и
	# детали удара не имеют права вытеснять из общего окна id прозы раунда. Соль
	# случайности (`&"reaction"`) разводит только потоки чисел — историю выбора она
	# не разводит вовсе, поэтому голос передаётся явно.
	var intro := TextGenerator.pick_phrase(
		&"", &"", SLOT_INTRO, intro_role(verdict, run, is_swap), rng, TextGenerator.VOICE_REACTION)
	var carrier := TextGenerator.pick_phrase(
		monster.id, &"", SLOT_CARRIER, &"", rng, TextGenerator.VOICE_REACTION)
	var verb := TextGenerator.pick_phrase(
		&"", &"", SLOT_VERB, verdict, rng, TextGenerator.VOICE_REACTION)
	var print_weapon := TextGenerator.pick_phrase(
		&"", &"", SLOT_WEAPON, StringName(weapon.id), rng, TextGenerator.VOICE_REACTION)
	if intro == null or carrier == null or verb == null or print_weapon == null:
		return ""
	var line: String = str(intro.text) + P_AFTER_INTRO \
		+ str(carrier.text) + P_BEFORE_VERB + str(verb.text) \
		+ P_BEFORE_WEAPON + str(print_weapon.text)
	# Без руны стихийная часть опускается вместе со своей запятой (§5). Это правило
	# сборщика: отдельные детали «пустой стихии» в пуле не нужны. И только если руна
	# ДОБАВЛЯЕТ тип удара: руна, равная базовому типу, второго типа не несёт.
	# Спрашиваем САМО оружие — «сколько типов у удара», — а не переписываем здесь
	# правило `damage_types_with` второй копией: одно правило в двух местах
	# расходится молча (AGENTS.md §4).
	if weapon.damage_types().size() > 1:
		var element := TextGenerator.pick_phrase(
			&"", &"", SLOT_ELEMENT, StringName(weapon.rune_type), rng, TextGenerator.VOICE_REACTION)
		if element != null:
			line += P_BEFORE_ELEMENT + str(element.text)
	return line + P_END
